# Copy to .env and fill in real values.

# Pooled connection string (Neon "Pooled connection" / Supabase "Transaction pooler")
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Direct connection string, used by `prisma migrate` / `prisma studio`
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
